{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["eventMetadata", "payload", "integrityProof"],
  "additionalProperties": false,
  "properties": {
    "eventMetadata": {
      "type": "object",
      "required": ["eventId", "eventType", "eventTimestamp", "sourceSystem"],
      "properties": {
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": { "type": "string", "enum": ["TRANSACTION", "LOG", "AUDIT", "ALERT"] },
        "eventTimestamp": { "type": "string", "format": "date-time" },
        "sourceSystem": { "type": "string", "minLength": 1 },
        "sourceSchemaVersion": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["entityType", "action", "data"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    },
    "integrityProof": {
      "type": "object",
      "required": ["hashAlgorithm", "sourceHash"],
      "properties": {
        "hashAlgorithm": { "const": "SHA-256" },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}