# --- API Middleware ---
API_PORT=3000
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
SIG_API_KEY=REPLACE_WITH_RANDOM_API_KEY_AT_LEAST_32_BYTES

# --- Base de corrélation / SIG (PostgreSQL en conteneur) ---
PGHOST=localhost
PGPORT=5432
PGUSER=sfd
PGPASSWORD=sfd_password
PGDATABASE=sfd_sig

# --- Fabric ---
FABRIC_TN=/absolute/path/to/fabric-samples/test-network
FABRIC_CHANNEL=sfdchannel
FABRIC_CHAINCODE=agnostictrace
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# --- Fabric service identities (MSP directories, not private-key files) ---
# FABRIC_IDENTITY_WRITER_MSP_DIR=/tmp/fabric-ca-writer/msp
# FABRIC_IDENTITY_READER_MSP_DIR=/tmp/fabric-ca-reader/msp
# FABRIC_IDENTITY_AUDITOR_MSP_DIR=/tmp/fabric-ca-auditor/msp

# --- RBAC integration tests only (local MSP directories; never commit private keys) ---
# FABRIC_TEST_WRITER_MSP_DIR=/path/to/writer/msp
# FABRIC_TEST_READER_MSP_DIR=/path/to/reader/msp
# FABRIC_TEST_AUDITOR_MSP_DIR=/path/to/auditor/msp